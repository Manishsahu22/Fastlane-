default_platform(:ios)

platform :ios do
  desc "Build iOS application for Simulator (.app bundle)"
  lane :build do
    puts "======================================"
    puts "Starting iOS build..."
    puts "======================================"

    # Install CocoaPods dependencies
    cocoapods(
      clean_install: true,
      podfile: "./ios/Podfile"
    )

    # Build the app for the Simulator
    build_app(
      workspace: "ios/QliniqKiosk.xcworkspace",
      scheme: "QliniQKiosk",
      configuration: "Release",
      
      # 1. Target the generic iOS Simulator (THIS IS THE FIX)
      destination: "generic/platform=iOS Simulator",
      
      # 2. Force the output into a specific folder so GitHub Actions can find it
      derived_data_path: "./build_output",
      
      # 3. Tell Fastlane to skip Archive and IPA packaging
      skip_archive: true,
      skip_package_ipa: true,
      skip_codesigning: true
    )

    puts "======================================"
    puts "Build completed!"
    puts "Output: build_output/Build/Products/Release-iphonesimulator/QliniQKiosk.app"
    puts "======================================"
  end
end
