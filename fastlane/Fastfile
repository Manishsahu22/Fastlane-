default_platform(:ios)

platform :ios do
  desc "Build iOS application"
  lane :build do
    puts "======================================"
    puts "Starting iOS build..."
    puts "======================================"

    # Install CocoaPods dependencies
    cocoapods(
      clean_install: true
    )

    # Automatically use the workspace generated by CocoaPods
    build_app(
      workspace: "ios/qliniq-kiosk.xcworkspace",
      scheme: "qliniq-kiosk",
      configuration: "Release",

      # Build for a real iOS device
      destination: "generic/platform=iOS",

      # Output location
      output_directory: "./build",
      output_name: "qliniq-kiosk.ipa",

      # Skip signing for now (change to false when certificates are configured)
      skip_codesigning: true
    )

    puts "======================================"
    puts "Build completed!"
    puts "Output: build/qliniq-kiosk.ipa"
    puts "======================================"
  end
end
