default_platform(:ios)

platform :ios do
  desc "Build iOS application"
  lane :build do
    puts "======================================"
    puts "Starting iOS build..."
    puts "======================================"

    # Install CocoaPods dependencies
    cocoapods(
      clean_install: true,
      podfile: "./ios/Podfile" # <--- Add this line
    )
    # Automatically use the workspace generated by CocoaPods
  build_app(
      workspace: "ios/QliniqKiosk.xcworkspace",
      scheme: "QliniQKiosk",
      configuration: "Release",
      
      # 1. Target the Simulator instead of a real device
      destination: "platform=iOS Simulator,name=iPhone 15",
      
      # 2. Force the output into a specific folder so GitHub Actions can find it
      derived_data_path: "./build_output",
      
      # 3. Tell Fastlane to skip Archive and IPA packaging
      skip_archive: true,
      skip_package_ipa: true,
      skip_codesigning: true
    )

    puts "======================================"
    puts "Build completed!"
    puts "Output: build/qliniq-kiosk.ipa"
    puts "======================================"
  end
end
