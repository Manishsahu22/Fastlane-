default_platform(:ios)

platform :ios do
  desc "Build iOS application"
  lane :build do
    puts "======================================"
    puts "Starting iOS build..."
    puts "======================================"

    # Install CocoaPods dependencies
    cocoapods(
      clean_install: true,
      podfile: "./ios/Podfile" # <--- Add this line
    )
    # Automatically use the workspace generated by CocoaPods
   build_app(
      workspace: "ios/QliniqKiosk.xcworkspace", # <--- Update exact casing/spelling here
      scheme: "QliniqKiosk",                    # <--- Update exact casing/spelling here
      configuration: "Release",
      destination: "generic/platform=iOS",
      output_directory: "./build",
      output_name: "qliniq-kiosk.ipa",
      skip_codesigning: true
    )

    puts "======================================"
    puts "Build completed!"
    puts "Output: build/qliniq-kiosk.ipa"
    puts "======================================"
  end
end
