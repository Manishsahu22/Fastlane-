default_platform(:ios)

platform :ios do

  desc "Build iOS application"
  lane :build do

    puts "======================================"
    puts "Starting iOS build"
    puts "======================================"

    # CocoaPods must run inside the ios/ directory
    Dir.chdir("ios") do
      sh("pod install --clean-install")
    end

    # Find the workspace (created by pod install) or fall back to project
    workspace = Dir.glob("ios/*.xcworkspace").first
    project   = Dir.glob("ios/*.xcodeproj").first

    puts "Workspace: #{workspace}"
    puts "Project:   #{project}"

    build_opts = {
      scheme: "qliniq-kiosk",
      configuration: "Release",
      skip_codesigning: true,
      destination: "generic/platform=iOS Simulator"
    }

    if workspace
      build_opts[:workspace] = workspace
    elsif project
      build_opts[:project] = project
    else
      UI.user_error!("No .xcworkspace or .xcodeproj found in ios/ directory")
    end

    # Build iOS application
    build_app(build_opts)

    puts "======================================"
    puts "iOS build completed successfully"
    puts "======================================"

  end

end
